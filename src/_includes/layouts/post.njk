---
layout: base.njk
---

<article class="post-container">

  <section>
    <header class="post-header">
      <div class="post-meta-top">
        {% if tags %}
          <div class="post-tags">
            {% for tag in tags | excludeTag("posts") %}
              <span class="post-tag">{{ tag }}</span>
            {% endfor %}
          </div>
        {% endif %}
        <time class="post-date" datetime="{{ date | dateISO }}">
          {{ date | dateJP }}
        </time>
        <div class="busyman">忙しい人向け</div>
      </div>
      <h1 class="post-title">{{ title }}</h1>
      {% if description %}
        <p class="post-description">{{ description }}</p>
      {% endif %}
    </header>
  </section>

  {% if category === "vidpick" %}
    <section class="zxc">
      {{ content | safe }}
    </section>
    {% include "components/contents.njk" %}
{% else %}
  <div class="body-copy">
    {{ content | safe }}
  </div>
{% endif %}

  <footer class="post-footer">
    <a href="/" class="back-link">
      <span class="back-arrow">←</span> 記事一覧に戻る
    </a>
  </footer>

</article>
