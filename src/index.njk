---
layout: base.njk
title: Home
pagination:
  data: collections.postsWithArticles
  size: 7
  alias: posts
---

<div class="home-container">

  <section class="home-hero">
    <p class="hero-eyebrow">Journal</p>
    <h1 class="hero-title">{{ site.name }}</h1>
    <p class="hero-description">{{ site.description }}</p>
  </section>

  <div class="cast-search">
    <input type="text" id="index-cast-search" list="cast-list" placeholder="俳優・タレント名で絞り込む">
    <button type="button" id="clearBtn" class="clear-btn" title="Delete inputed text">×</button>
  </div>

<section class="index-search-result">
  <div id="search-results" hidden></div>
</section>

  <section class="post-list-section">
    <div class="post-list">

      {% for post in posts %}
      <article class="post-card">
        <div class="post-card-meta">
          <time datetime="{{ post.date | dateISO }}">{{ post.date | dateJP }}</time>
          {% if post.data.tags %}
            <div class="post-card-tags">
              {% for tag in post.data.tags | excludeTag("posts") %}
                <span class="post-tag">{{ tag }}</span>
              {% endfor %}
            </div>
        </div>
            <h2 class="post-card-title">
              <a href="{{ post.url }}">{{ post.data.title }}</a>
              <svg role="img" width="13.35px" height="13.35px" class="line-left-to-up"><use href="#line-left-to-up"></use></svg>
            </h2>
            {% if post.data.description %}
              <p class="post-card-excerpt">{{ post.data.description }}</p>
            {% endif %}
          {% endif %}
          {% if post.relatedArticles.length %}
          <ul class="related-articles">
            {% for art in post.relatedArticles %}
            <li>
              <span><a href="{{ art.url }}">{{ art.data.title }}</a>
                <span class="casts">{{ art.data.cast | join("｜") }}</span>
                  {% if art.daysLeft !== null %}
                    <span class="art-expiry" title="関連記事の公開期限">{{ art.daysLeft }}</span>
                  {% endif %}
                </span>
              <span class="summary">{{ art.data.summary }}</span>
            </li>
            {% endfor %}
          </ul>
          {% endif %}

      </article>
      {% endfor%}

    </div>
  </section>

</div>

<nav id="articleList-pagination" aria-labelledby="pagination">
  <ol class="pagination">
    <li>{% if pagination.href.previous %}<a href="{{ pagination.href.previous }}"><button class="previous">Prev</button></a>{% else %}<button class="previous text-gray-800 bg-gray-600 aria-disabled cursor-not-allowed">Prev</button>{% endif %}</li>
	<li>{% if pagination.href.next %}<a href="{{ pagination.href.next }}"><button class="next">Next</button></a>{% else %}<button class="next text-gray-800 bg-gray-600 aria-disabled cursor-not-allowed">Next</button>{% endif %}</li>

{% macro renderTitleDate(firstObj, lastObj) %}
  {%- if firstObj and lastObj -%}
    {# 最初の日付のフォーマット #}
    {%- if firstObj.year -%}{{ firstObj.year }}/{%- endif -%}{{ firstObj.month }}/{{ firstObj.day }}{{ " ～ " }}{%- if lastObj.year -%}{{ lastObj.year }}/{%- endif -%}{{ lastObj.month }}/{{ lastObj.day }}のピックアップ
  {%- endif -%}
{% endmacro %}

{%- for pageEntry in pagination.pages %}
  {%- set firstPost = pageEntry | first -%}
  {%- set lastPost = pageEntry | last -%}
  {%- set firstDateObj = firstPost.date | getPageDateObj -%}
  {%- set lastDateObj = lastPost.date | getPageDateObj -%}
    <li>
      {# <a href="{{ pagination.hrefs[ loop.index0 ] }}"{% if page.url == pagination.hrefs[ loop.index0 ] %}
        aria-current="page"{% endif %}
        title="{{ renderTitleDate(firstDateObj, lastDateObj) }}">Page {{ loop.index }}</a> #}
        <a href="{{ pagination.hrefs[ loop.index0 ] }}"
                   {% if page.url == pagination.hrefs[ loop.index0 ] %} aria-current="page"{% endif %}
                   title="{{ renderTitleDate(firstDateObj, lastDateObj) }}">
                  Page {{ loop.index }}
                </a>
    </li>
{%- endfor %}
  </ol>
</nav>
